q!
# Development Environment Overrides
environment: dev
namespace: easytravel-dev

# Lower resource limits for dev
mongodb:
  replicaCount: 1
  resources:
    requests:
      memory: "256Mi"
      cpu: "250m"
    limits:
      memory: "512Mi"
      cpu: "500m"
  persistence:
    size: 5Gi

backend:
  replicaCount: 1
  resources:
    requests:
      memory: "300Mi"
      cpu: "200m"
    limits:
      memory: "400Mi"
      cpu: "400m"
  autoscaling:
    enabled: false

frontend:
  replicaCount: 1
  resources:
    requests:
      memory: "300Mi"
      cpu: "200m"
    limits:
      memory: "400Mi"
      cpu: "400m"
  autoscaling:
    enabled: false

angularFrontend:
  replicaCount: 1
  resources:
    requests:
      memory: "300Mi"
      cpu: "200m"
    limits:
      memory: "400Mi"
      cpu: "400m"
  autoscaling:
    enabled: false

nginx:
  replicaCount: 1
  service:
    type: ClusterIP

loadgen:
  enabled: true
  replicaCount: 1

headlessLoadgen:
  customer:
    enabled: false
  angular:
    enabled: false

ingress:
  enabled: true
  hosts:
    - host: easytravel-dev.yourdomain.com
      paths:
        - path: /
          pathType: Prefix
          service: nginx-service
          port: 80
  tls:
    - secretName: easytravel-dev-tls
      hosts:
        - easytravel-dev.yourdomain.com

networkPolicy:
  enabled: false

podDisruptionBudget:
  enabled: false

serviceMonitor:
  enabled: true
